# =============================================================================
# Shopware Admin Extension Example - Environment Configuration
# =============================================================================
# This file contains the configuration for the admin extension example.
# Copy this file to .env and update the values for your environment.
#
# Quick Start:
# 1. cp env.example .env
# 2. Generate TOKEN_SECRET: openssl rand -base64 32
# 3. Update TOKEN_SECRET in .env
# 4. docker-compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Shopware App Configuration
# -----------------------------------------------------------------------------
# These values MUST match the app/manifest.xml file

# App name from manifest.xml <label> tag
SHOPWARE_APP_NAME=AdminExtensionApp

# App secret from manifest.xml <secret> tag
# SECURITY: Keep this secret! It's used for signature verification during registration
SHOPWARE_APP_SECRET=my-super-secret-key-12345

# Registration callback URL - where Shopware sends the confirmation request
# For Docker-based local development: use host.docker.internal and the backend host port
# For production: Use your production domain
SHOPWARE_CONFIRMATION_URL=http://host.docker.internal:8085/app/register/confirm

# -----------------------------------------------------------------------------
# Frontend Authentication
# -----------------------------------------------------------------------------
# Token secret for encrypting frontend auth tokens (AES-256-GCM)
# SECURITY: Must be at least 32 characters for AES-256
# Generate a secure random secret:
#   openssl rand -base64 32
TOKEN_SECRET=CHANGE-ME-USE-openssl-rand-base64-32-TO-GENERATE

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# SQLite database path for storing shop credentials
# The directory will be created automatically if it doesn't exist
# For Docker: Use /app/data/shops.db (persisted via volume)
# For local dev: Use ./data/shops.db
DATABASE_PATH=./data/shops.db

# -----------------------------------------------------------------------------
# Server Configuration (for local development without Docker)
# -----------------------------------------------------------------------------
# Internal server address and port
# Docker Compose overrides this to :8080 in the container
# For local dev: Use :8085 to avoid conflicts
SERVER_ADDR=:8080
