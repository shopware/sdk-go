# Shopware App Configuration
SHOPWARE_APP_NAME=GinShopwareApp
SHOPWARE_APP_SECRET=your-app-secret-from-manifest-xml
SHOPWARE_CONFIRMATION_URL=http://localhost:8080/app/register/confirm

# Server Configuration
SERVER_ADDR=:8080
ENVIRONMENT=development

# Store Configuration
# Options: sqlite, memory, dynamodb
STORE_TYPE=sqlite

# SQLite Configuration (only if STORE_TYPE=sqlite)
DATABASE_PATH=./data/shops.db

# Admin API Token Storage
# memory: tokens live in this process (fine for a single instance)
# redis:  tokens are shared through Redis or Valkey (use it for several instances)
TOKEN_STORAGE=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
TOKEN_KEY_PREFIX=gin-service:token:
# Optional: encrypt tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# DynamoDB Configuration (only if STORE_TYPE=dynamodb)
DYNAMODB_TABLE=shopware-shops
DYNAMODB_REGION=us-east-1

# For DynamoDB Local (development):
# DYNAMODB_ENDPOINT=http://dynamodb-local:8000
# AWS_ACCESS_KEY_ID=dummy  # DynamoDB Local doesn't require real credentials
# AWS_SECRET_ACCESS_KEY=dummy

# For AWS DynamoDB (production):
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# Or use IAM roles/instance profiles

